{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thatmovienight.life/schemas/movie-appeal-update.schema.json",
  "title": "TMNL Movie Appeal Update Batch",
  "description": "Legacy update-array format accepted by scripts/merge_movie_appeal_worker_updates.py.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "slug",
      "summary",
      "source_quotes"
    ],
    "properties": {
      "slug": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 420,
        "description": "Must include at least one exact quoted fragment from source_quotes[].text."
      },
      "appeal_tags": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+(\\s+\\S+){1,3}$"
        }
      },
      "good_pick_if": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "maybe_skip_if": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "nearby_comps": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "confidence": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "source_quotes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "source",
            "url"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "^Letterboxd review by .+"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
